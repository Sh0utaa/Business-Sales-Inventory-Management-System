{
  "name": "business-system",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@sap/cds": "^10.1.0",
    "@sap/xssec": "^4"
  },
  "cds": {
    "requires": {
      "auth": {
        "kind": "mocked",
        "users": {
          "shota": {
            "password": "123",
            "roles": [
              "Customer"
            ]
          },
          "giorgi": {
            "password": "123",
            "roles": [
              "Employee",
              "Admin"
            ]
          },
          "nino": {
            "password": "123",
            "roles": [
              "Employee",
              "Manager"
            ]
          },
          "sandro": {
            "password": "123",
            "roles": [
              "Employee",
              "Delivery"
            ]
          }
        }
      },
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db/db.sqlite"
        }
      },
      "[production]": {
        "auth": "xsuaa"
      }
    }
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-products": "cds watch --open products/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-business-ui": "cds watch --open businessui/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/products",
    "app/business-ui"
  ]
}